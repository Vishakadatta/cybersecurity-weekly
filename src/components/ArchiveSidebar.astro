---
import fs from 'node:fs';
import path from 'node:path';

const base = import.meta.env.BASE_URL;
const contentDir = path.join(process.cwd(), 'content');

interface WeekEntry {
  year: string;
  week: string;
  label: string;
  path: string;
}

const weeks: WeekEntry[] = [];

if (fs.existsSync(contentDir)) {
  const years = fs.readdirSync(contentDir).filter((f) => /^\d{4}$/.test(f)).sort().reverse();
  for (const year of years) {
    const yearDir = path.join(contentDir, year);
    const files = fs.readdirSync(yearDir).filter((f) => f.endsWith('.json')).sort().reverse();
    for (const file of files) {
      const week = file.replace('.json', '');
      weeks.push({
        year,
        week,
        label: `${year} — Week ${week.replace('w', '')}`,
        path: `${base}archive/${year}-${week}/`,
      });
    }
  }
}
---

<aside class="w-full lg:w-72 shrink-0">
  <div class="sticky top-8 rounded-xl border border-dark-800 bg-dark-900/50 p-5">
    <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-dark-400">Archive</h2>
    {weeks.length === 0 ? (
      <p class="text-sm text-dark-500 italic">No archives yet. Check back after the first week!</p>
    ) : (
      <ul class="space-y-1">
        {weeks.map((w) => (
          <li>
            <a
              href={w.path}
              class="block rounded-lg px-3 py-2 text-sm text-dark-300 transition hover:bg-dark-800 hover:text-cyber-400"
            >
              {w.label}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</aside>
