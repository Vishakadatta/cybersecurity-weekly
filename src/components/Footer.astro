---
const year = new Date().getFullYear();
---

<footer class="border-t border-dark-800 py-8 mt-16">
  <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
    <p class="text-sm text-dark-500">
      &copy; {year} Cybersecurity Weekly. Fully automated, zero cost.
    </p>
    <div class="flex items-center gap-4">
      <a
        href="https://github.com/Vishakadatta/cybersecurity-weekly"
        target="_blank"
        rel="noopener"
        class="text-sm text-dark-400 transition hover:text-cyber-400"
      >
        GitHub
      </a>
      <a
        href="https://github.com/Vishakadatta/cybersecurity-weekly/issues/new?template=subscribe.yml&title=Subscribe"
        target="_blank"
        rel="noopener"
        class="text-sm text-dark-400 transition hover:text-cyber-400"
      >
        Subscribe
      </a>
      <a
        href="https://github.com/Vishakadatta/cybersecurity-weekly/issues/new?template=unsubscribe.yml&title=Unsubscribe"
        target="_blank"
        rel="noopener"
        class="text-sm text-dark-400 transition hover:text-cyber-400"
      >
        Unsubscribe
      </a>
    </div>
  </div>
</footer>
