---
const base = import.meta.env.BASE_URL;
---

<header class="border-b border-dark-800 py-6">
  <div class="flex items-center justify-between">
    <a href={base} class="group flex items-center gap-3">
      <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-cyber-500/10 ring-1 ring-cyber-500/30 transition group-hover:bg-cyber-500/20">
        <svg class="h-5 w-5 text-cyber-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
        </svg>
      </div>
      <div>
        <h1 class="text-lg font-bold tracking-tight text-white">Cybersecurity Weekly</h1>
        <p class="text-xs text-dark-400">AI-curated security news, every Monday</p>
      </div>
    </a>
    <nav class="flex items-center gap-4">
      <a href={base} class="text-sm text-dark-300 transition hover:text-cyber-400">This Week</a>
      <a href={`${base}archive/`} class="text-sm text-dark-300 transition hover:text-cyber-400">Archive</a>
      <a
        href="https://github.com/Vishakadatta/cybersecurity-weekly/issues/new?template=subscribe.yml&title=Subscribe"
        target="_blank"
        rel="noopener"
        class="rounded-lg bg-cyber-500 px-4 py-2 text-sm font-medium text-dark-950 transition hover:bg-cyber-400"
      >
        Subscribe
      </a>
    </nav>
  </div>
</header>
