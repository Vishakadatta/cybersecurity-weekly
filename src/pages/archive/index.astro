---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import fs from 'node:fs';
import path from 'node:path';

const base = import.meta.env.BASE_URL;
const contentDir = path.join(process.cwd(), 'content');

interface EditionEntry {
  year: string;
  edition: string;
  label: string;
  path: string;
  subjectLine: string;
  articleCount: number;
  generatedAt: string;
}

function formatLabel(edition: string): string {
  if (/^\d{4}-\d{2}-\d{2}$/.test(edition)) {
    const d = new Date(edition + 'T12:00:00');
    return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
  }
  return edition.replace('w', 'Week ');
}

const editions: EditionEntry[] = [];

if (fs.existsSync(contentDir)) {
  const years = fs.readdirSync(contentDir).filter((f) => /^\d{4}$/.test(f)).sort().reverse();
  for (const year of years) {
    const yearDir = path.join(contentDir, year);
    const files = fs.readdirSync(yearDir).filter((f) => f.endsWith('.json')).sort().reverse();
    for (const file of files) {
      const edition = file.replace('.json', '');
      const data = JSON.parse(fs.readFileSync(path.join(yearDir, file), 'utf-8'));
      editions.push({
        year,
        edition,
        label: data.editionLabel || formatLabel(edition),
        path: `${base}archive/${edition}/`,
        subjectLine: data.subjectLine || 'Cybersecurity Weekly',
        articleCount: data.articles?.length ?? 0,
        generatedAt: data.generatedAt || '',
      });
    }
  }
}
---

<BaseLayout title="Archive — Cybersecurity Weekly">
  <Header />

  <main class="py-10">
    <h2 class="mb-8 text-3xl font-extrabold tracking-tight text-white">Archive</h2>

    {editions.length === 0 ? (
      <div class="rounded-2xl border border-dark-800 bg-dark-900/50 px-8 py-16 text-center">
        <p class="text-dark-400">No archived editions yet. Check back after the first weekly cycle.</p>
      </div>
    ) : (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {editions.map((e) => (
          <a
            href={e.path}
            class="group rounded-xl border border-dark-800 bg-dark-900/50 p-6 transition hover:border-dark-700 hover:bg-dark-900"
          >
            <p class="mb-1 text-sm font-medium text-cyber-400">{e.label}</p>
            <h3 class="mb-2 text-lg font-semibold text-white transition group-hover:text-cyber-400">
              {e.subjectLine}
            </h3>
            <p class="text-sm text-dark-400">
              {e.articleCount} articles
              {e.generatedAt && (
                <span>
                  &middot; {new Date(e.generatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                </span>
              )}
            </p>
          </a>
        ))}
      </div>
    )}
  </main>

  <Footer />
</BaseLayout>
