# @astrojs/tailwind 5.x declares peer astro@"^3 || ^4 || ^5" but works fine
# at runtime against astro 6. Until @astrojs/tailwind 6 + @tailwindcss/vite
# 4.x has the Rolldown incompat fixed upstream (see commit history), we keep
# this combo and tell npm to stop blocking the install.
legacy-peer-deps=true
